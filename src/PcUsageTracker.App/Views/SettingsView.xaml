<UserControl x:Class="SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="600"
             Background="#12121A">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,24">
            <TextBlock Text="设置" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryText}" Margin="0,0,0,20" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="空闲检测" />
                    <TextBlock Text="设置空闲超时阈值（分钟），超过此时间未操作则认为空闲"
                               Foreground="{StaticResource SecondaryText}" FontSize="12"
                               Margin="0,0,0,12" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="空闲阈值：" VerticalAlignment="Center"
                                   Foreground="{StaticResource PrimaryText}" FontSize="14" />

                        <Slider Grid.Column="1" Minimum="1" Maximum="30"
                                Value="{Binding IdleThresholdMinutes}"
                                Margin="16,0" IsSnapToTickEnabled="True"
                                TickFrequency="1" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IdleThresholdMinutes}"
                                       Foreground="{StaticResource AccentColor}"
                                       FontSize="18" FontWeight="Bold" />
                            <TextBlock Text=" 分钟" Foreground="{StaticResource SecondaryText}"
                                       FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="开机启动" />
                    <TextBlock Text="设置是否在系统启动时自动运行此程序"
                               Foreground="{StaticResource SecondaryText}" FontSize="12"
                               Margin="0,0,0,12" />

                    <CheckBox IsChecked="{Binding AutoStartEnabled}"
                              Foreground="{StaticResource PrimaryText}" FontSize="14"
                              VerticalAlignment="Center">
                        <CheckBox.LayoutTransform>
                            <ScaleTransform ScaleX="1.2" ScaleY="1.2" />
                        </CheckBox.LayoutTransform>
                    </CheckBox>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitleStyle}" Text="关于" />
                    <TextBlock Text="PC Usage Tracker v1.0" FontSize="14"
                               Foreground="{StaticResource PrimaryText}" />
                    <TextBlock Text="统计电脑每日使用时间，帮助你更好地了解自己的电脑使用习惯。"
                               Foreground="{StaticResource SecondaryText}" FontSize="12"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                    <TextBlock Foreground="{StaticResource SuccessColor}" FontSize="12"
                               Margin="0,8,0,0"
                               Text="{Binding StatusMessage}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>